# ============================================================
# TEMPLATE — copy this file to .env.local and fill in real values.
# .env.local is gitignored, .env.example is safe to commit.
# ============================================================

# --- Django ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True

# --- Database (PostgreSQL) ---
DB_NAME=garaz_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Stripe ---
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# --- Email (Gmail SMTP) ---
# Generate an App Password at https://myaccount.google.com/apppasswords
# Leave empty to fall back to console backend in DEBUG mode.
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# --- Google OAuth (used by seed.py) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=GOCSPX-xxxxxxxx
